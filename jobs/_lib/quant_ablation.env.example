# CISLNet quantization ablation environment variables
# Source before sbatch or export inline. See cislnet/quantization/config.py

# --- Precision ---
export QUANT_PRECISION=int8          # fp16 | fp8 | int8 | int4 | int32
export QUANT_BITS=8                  # 4 | 8 (for QAT / PTQ integer)
export QUANT_FP8_NATIVE=1            # 1 = e4m3fn weight storage on H100 (default); 0 = fp32 bake

# --- PTQ calibration ---
export QUANT_USE_ACT_SCALE=0         # 1 merges activation max into weight scale (SmoothQuant-style)
export QUANT_ACT_QUANT_INFERENCE=0   # 1 = fake-quant activations at inference (needs use_act_scale)
export QUANT_CALIB_PERCENTILE=100    # 99.9 clips outlier activations
export CALIB_NUM_PATCHES=1024
export CALIB_BATCH_SIZE=8

# --- Layer selection ---
export QUANT_SKIP_CBAM=0             # 1 = keep CBAM at fp32
export QUANT_SKIP_PATTERNS=""        # comma-separated substrings, e.g. final_upsample,cbam

# --- Storage ---
export QUANT_STORE_PARAMS_FP32=1     # BN/bias fp32 (recommended)

# --- QAT (train_qat.sh) ---
export QAT_ENABLED=0
export QAT_EPOCHS=5
export QAT_LR=1e-5
export QAT_BATCH_SIZE=4
export QAT_FAKE_QUANT_WEIGHT=1
export QAT_FAKE_QUANT_ACTIVATION=1
export QAT_FREEZE_DISCRIMINATOR=1
export QAT_FREEZE_NETF=1

# --- Inference ---
export QUANT_INFERENCE_MODE=auto     # auto | fp32_dequant | fp8_native | integer_gemm
export QUANT_INTEGER_GEMM=0          # 1 enables integer GEMM path (reference / FPGA golden)

# --- FPGA export ---
export QUANT_FPGA_EXPORT=0
export QUANT_FPGA_EXPORT_FORMAT=manifest_v1

# --- Eval ---
export VSLITE_INFER_BS=32
export VSLITE_INFER_WARMUP_BATCHES=2
