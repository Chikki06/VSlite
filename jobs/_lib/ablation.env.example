# Copy to ablation.env and customize, or export before sbatch.
# All VSlite train jobs should honor these variables.

# --- Required ---
export NUM_CHANNELS=13          # 3 | 6 | 10 | 13
export PATCH_SIZE=512
export BATCH_SIZE=8
export GRAD_ACCUM_STEPS=1
export EPOCHS=50

# --- Regularization ---
export WEIGHT_DECAY=0.0
export DROPOUT=0.0
export NO_AUG=0                 # 1 disables augmentation
export AUG_STRENGTH=1.0
export HE_COLOR_SPACE=srgb        # srgb | linear

# --- Loss weights ---
export LAMBDA_L1=1.0
export LAMBDA_NCE=10.0
export LAMBDA_PERC=10.0
export LAMBDA_GAN=1.0
export NO_GAN=0

# --- Optimizer ---
export LR=0.0002
export OPTIMIZER=adam             # adam | adamw
export LR_SCHEDULE=fixed          # fixed | cosine | plateau
export WARMUP_EPOCHS=0
export EMA_DECAY=0.0

# --- Early stopping (val L1) ---
export EARLY_STOP_PATIENCE=0      # 0 = disabled
export EARLY_STOP_MIN_DELTA=0.0001

# --- Progressive training (Restormer / FCN) ---
# export PROGRESSIVE_SCHEDULE=256:10,512:40

# --- Preview ---
# export PREVIEW_TILE_LIST=/path/to/preview_tiles.json

# --- Run paths ---
# export RUN=a13
# export OUTPUT_DIR=$VSLITE_ROOT/results/restormer/a13
