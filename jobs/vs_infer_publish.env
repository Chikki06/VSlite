# VS inference + publish configuration
# Source this file from jobs/vs_infer_publish_all.sh, or edit defaults there.

# Repo root; auto-detected by script if empty.
VSLITE_ROOT="/projects/illinois/eng/bioe/rxb/akshat/VSlite"

# Input IR parent directory. VIS TIFFs are expected in sibling VIS directory.
INPUT_PARENT="/projects/illinois/eng/bioe/rxb/akshat/VSlite/input/IR"

# Model discovery under results/*/*latest*.pth
MODEL_DISCOVERY_ROOT="/projects/illinois/eng/bioe/rxb/akshat/VSlite/results"
MODEL_NAME_PATTERN="latest_net_G.pth"

# Optional override file format (pipe-separated):
# /absolute/ckpt/path|model_type|vs_modality
# model_type is 0 (10ch) or 1 (13ch)
MODEL_OVERRIDES_FILE=""

# Prefix used for auto-generated modality names.
MODALITY_PREFIX="VS"

# Inference execution
PYTHON_BIN="python"
INFER_BATCH_SIZE="1"
INFER_NUM_WORKERS="0"
ENABLE_OPTIM="false"
SAVE_PNG_ONLY="true"

# Local staging directory (inference outputs written here)
LOCAL_STAGING_DIR="$HOME/vs_infer_staging"

# Remote target location
REMOTE_PROJECT_BASE="/mnt/files"
PROJECT_ID="444"

# Publish target
REMOTE_HOST="akshahi2@cisl-inference.beckman.illinois.edu"
REMOTE_BASE_DIR="/mnt/files/444"
REMOTE_WORKDIR="/tmp/vs_publish_akshahi2"

# Remote DB location
REMOTE_DB_PATH="/home/labuser/SocketInference/viewer/instance/tissue_images.db"
REMOTE_HELPER_PATH="/home/labuser/SocketInference/viewer/misc"

# DB update strategy:
# - remote: run DB updates directly on remote host
# - roundtrip: rsync DB local -> update -> rsync DB back
# - rsync_only: same as roundtrip, explicit for environments without ssh shell access
DB_UPDATE_MODE="rsync_only"

# If false, the publisher will not run remote ssh commands (mkdir / remote helper execution)
REMOTE_SHELL_ENABLED="false"

# Runtime controls
SYNC_ENABLED="false"
DB_UPDATE_ENABLED="false"
DRY_RUN="false"

# Local working state
STATE_DIR="/projects/illinois/eng/bioe/rxb/akshat/VSlite/results/inference_publish_state"
